flowchart LR

  s_start(["Screening Requested"]):::start
  normalize["Normalize & Transliterate"]:::system
  list_screen["Global Watchlist Screening"]:::system
  d_hit{"Potential hit?"}:::decision
  fuzzy["Fuzzy Match Scoring"]:::system
  analyst[/"Analyst Adjudication"/]:::manual
  d_true{"True match?"}:::decision
