flowchart LR

  u_start(["Underwriting Triggered"]):::start
  foir["Compute FOIR / DTI"]:::system
  elig["Eligibility Ruleset"]:::system
  d_elig{"Eligible?"}:::decision
  afford["Affordability Model"]:::system
  limit["Limit & Indicative Pricing"]:::system
  u_done(["Decision Ready"]):::end
